{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "title": "SolarBI - Calidad y desempeño",
  "uid": "solarbi-g50",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "2026-10-05T00:00:00.000Z",
    "to": "2026-10-08T00:00:00.000Z"
  },
  "tags": [
    "solarbi",
    "g50"
  ],
  "templating": {
    "list": [
      {
        "name": "dispositivo",
        "label": "Dispositivo",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRES}"
        },
        "query": "SELECT DISTINCT dispositivo_id FROM silver.lectura_5min ORDER BY 1",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "1",
          "value": "1"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Irradiancia y potencia AC (cada 5 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", irradiancia_wm2 AS \"Irradiancia (W/m2)\", p_ac_kw * 1000 AS \"Potencia AC (W)\"\nFROM silver.lectura_5min\nWHERE $__timeFilter(ts) AND dispositivo_id = ${dispositivo}\nORDER BY ts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "% de datos válidos",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT AVG(pct_datos_validos) AS \"% datos validos\"\nFROM dwh.fact_energia_dia\nWHERE dispositivo_key = ${dispositivo}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Energía total del periodo (kWh)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT SUM(energia_kwh) AS \"Energia (kWh)\"\nFROM dwh.fact_energia_dia\nWHERE dispositivo_key = ${dispositivo}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Energía diaria (kWh)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT to_char(fecha_key, 'YYYY-MM-DD') AS dia, energia_kwh AS \"Energia (kWh)\"\nFROM dwh.fact_energia_dia\nWHERE dispositivo_key = ${dispositivo}\nORDER BY fecha_key"
        }
      ],
      "options": {
        "xField": "dia"
      }
    }
  ]
}